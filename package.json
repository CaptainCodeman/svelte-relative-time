{
	"name": "svelte-relative-time",
	"description": "Efficient, lightweight, auto-updating timeago timestamps for Svelte",
	"version": "0.0.6",
	"type": "module",
	"keywords": [
		"svelte",
		"component",
		"ui",
		"attachment",
		"time",
		"date",
		"datetime",
		"timestamp",
		"timeago",
		"relative",
		"relative-time"
	],
	"homepage": "https://captaincodeman.github.io/svelte-relative-time/",
	"repository": {
		"type": "git",
		"url": "https://github.com/captaincodeman/svelte-relative-time.git"
	},
	"author": {
		"name": "Simon Green",
		"email": "simon@captaincodeman.com",
		"url": "https://www.captaincodeman.com/"
	},
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"autoprefixer": "^10.4.19",
		"publint": "^0.3.25",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.6.3",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
